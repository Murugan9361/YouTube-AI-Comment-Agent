APP_NAME="YouTube AI Comment Agent"
DEBUG=False

BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8501

# Safety: DRY_RUN=true (the default when unset) verifies ownership but posts NOTHING.
# Set DRY_RUN=false only when you really want comments published.
DRY_RUN=true

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/youtube.force-ssl

AI_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=your-secret-key

# Meta (Instagram & Facebook) OAuth Credentials
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
# Webhook Configuration
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string

# Optional: Custom Scopes (Comma-separated, useful if app has specific permissions enabled)
# META_SCOPES_IG=public_profile,pages_show_list,pages_read_engagement,instagram_basic,instagram_manage_comments
# META_SCOPES_FB=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts,pages_manage_engagement
